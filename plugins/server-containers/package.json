{
  "name": "@smp/console-server-containers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "容器服务器类型、容器面板和容器设置",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "scripts/*.sh"
  ],
  "engines": {
    "dsh": "0.2.1-alpha.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-plugin.mjs",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@smp/console-server-management": "file:../server-management",
    "@smp/console-container-runtime": "file:../container-runtime"
  }
}
